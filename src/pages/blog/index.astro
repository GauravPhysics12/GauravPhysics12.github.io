---
import { parse, isBefore } from 'date-fns';
import { Container, BlogPostsList } from '@components/odyssey-theme';
import Layout from '../../layouts/Page.astro';

const posts = await Astro.glob('./posts/*.mdx').then(posts =>
  posts
    .map(({ frontmatter, url }) => ({
      title: frontmatter.title,
      description: frontmatter.description,
      authors: frontmatter.authors,
      publishDate: parse(frontmatter.publishDate, 'MMM d, yyyy', new Date()),
      featuredImage: frontmatter.featuredImage,
      excerpt: frontmatter.excerpt,
      href: url,
    }))
    .sort((a, b) => {
      if (isBefore(a.publishDate, b.publishDate)) return 1;
      if (isBefore(b.publishDate, a.publishDate)) return -1;
      return 0;
    })
);

const seo = {
  title: 'Blog',
  description: 'My blog about physics, astrophotography, and interesting science.',
};
---

<Layout {seo}>
  <Container>
    <div class="page-hero">
      <h1>My Blog</h1>
      <p>A collection of posts about my research, astrophotography, and interesting science.</p>
    </div>

    <section class="blog-posts-list__section">
      <h2>Recent Posts</h2>
      <BlogPostsList posts={posts} />
    </section>
  </Container>

 <!-- Feynman Quote at the end -->
  <div class="feynman-quote">
    <span class="feynman-quote__mark" aria-hidden="true">&ldquo;</span>
    <p>Nobody ever figures out what life is all about, and it doesn't matter. Explore the world. Nearly everything is really interesting if you go into it deeply enough.</p>
    <p class="author">— Richard Feynman</p>
  </div>
</Layout>



<style>
  .blog-posts-list__section {
    margin: var(--section-margin) auto;
  }

  .page-hero {
    text-align: center;
    padding: 5rem 1rem 3rem;
  }
  .page-hero h1 {
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    margin-bottom: 0.75rem;
  }
  .page-hero p {
    color: var(--theme-on-bg-muted);
    max-width: 620px;
    margin: 0 auto;
  }

  .feynman-quote {
    position: relative;
    margin: 5rem auto;
    padding: 3rem 1.5rem;
    max-width: 720px;
    text-align: center;
  }
  .feynman-quote__mark {
    display: block;
    font-family: var(--theme-font-family-serif);
    font-size: 5rem;
    line-height: 1;
    color: var(--theme-highlight);
    opacity: 0.5;
    margin-bottom: -1rem;
  }
  .feynman-quote p:not(.author) {
    font-style: italic;
    font-size: 1.3rem;
    line-height: 1.6;
    color: var(--theme-on-bg);
    font-family: var(--theme-font-family-serif);
  }
  .feynman-quote .author {
    font-style: normal;
    font-weight: 700;
    margin-top: 1.25rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: var(--font-size-sm);
    color: var(--theme-primary);
  }
</style>

