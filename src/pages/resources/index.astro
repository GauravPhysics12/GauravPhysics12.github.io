---
import { Container } from '@components/odyssey-theme';
import Layout from '../../layouts/Page.astro';
import { getCollection } from 'astro:content';
import { categories } from '../../config/notes.js';
import { topics } from '../../config/topics.js';

const allCodePosts = await getCollection('codes');

// Group code posts by topic (e.g. "Numerical Relativity") so the Code tab
// is organized rather than one flat grid. Any code post not claimed by a
// topic still shows, under "Other".
const claimedSlugs = new Set(topics.flatMap((t) => t.codeSlugs));
const codeGroups = topics
	.map((topic) => ({
		name: topic.name,
		posts: topic.codeSlugs.map((slug) => allCodePosts.find((p) => p.slug === slug)).filter(Boolean),
	}))
	.filter((group) => group.posts.length > 0);

const otherPosts = allCodePosts.filter((p) => !claimedSlugs.has(p.slug));
if (otherPosts.length > 0) {
	codeGroups.push({ name: 'Other', posts: otherPosts });
}
---

<Layout>
	<Container>
		<div class="page-hero">
			<h1>Resources</h1>
			<p>Code, simulations, notes, and lecture slides from my work — browse by type.</p>
		</div>

		<div class="resource-tabs" role="tablist">
			<button class="resource-tab is-active" data-tab="code" role="tab" aria-selected="true">
				&#128187; Code &amp; Simulations
			</button>
			<button class="resource-tab" data-tab="notes" role="tab" aria-selected="false">
				&#128220; Notes &amp; Slides
			</button>
		</div>

		<section class="resource-panel" data-panel="code">
			{codeGroups.map((group) => (
				<div class="code-group">
					<h2 class="code-group__label">{group.name}</h2>
					<div class="posts-grid">
						{group.posts.map((post) => (
							<a href={`/codes/${post.slug}`} class="post-card">
								{post.data.featuredImage && (
									<div class="post-card__image-wrap">
										<img src={post.data.featuredImage} alt={post.data.title} class="post-card__image" />
									</div>
								)}
								<div class="post-card__content">
									<h3>{post.data.title}</h3>
									<p>{post.data.excerpt}</p>
								</div>
							</a>
						))}
					</div>
				</div>
			))}
		</section>

		<section class="resource-panel" data-panel="notes" hidden>
			<p class="notes-intro">
				These notes are a synthesis of core texts like Sean Carroll's <em>Spacetime and Geometry</em>, Bernard Schutz's <em>A First Course in General Relativity</em>, and Prof. Frederic Schuller's lectures — plus slides from my own guest lectures and workshops.
			</p>
			<div class="notes-list">
				{categories.map((category) => (
					<a href={`/physics-notes/${category.slug}`} class="category-card">
						<h2>{category.name}</h2>
						<p>{category.description}</p>
					</a>
				))}
			</div>
		</section>
	</Container>

	<div class="feynman-quote">
		<span class="feynman-quote__mark" aria-hidden="true">&ldquo;</span>
		<p>Study hard what interests you the most in the most undisciplined, irreverent and original manner possible.</p>
		<p class="author">— Richard Feynman</p>
	</div>
</Layout>

<script is:inline>
	document.addEventListener('DOMContentLoaded', function () {
		const tabs = document.querySelectorAll('.resource-tab');
		const panels = document.querySelectorAll('.resource-panel');

		tabs.forEach((tab) => {
			tab.addEventListener('click', () => {
				const target = tab.getAttribute('data-tab');

				tabs.forEach((t) => {
					t.classList.toggle('is-active', t === tab);
					t.setAttribute('aria-selected', t === tab ? 'true' : 'false');
				});
				panels.forEach((panel) => {
					panel.hidden = panel.getAttribute('data-panel') !== target;
				});
			});
		});
	});
</script>

<style>
	.page-hero {
		text-align: center;
		padding: 5rem 1rem 2rem;
	}
	.page-hero h1 {
		font-size: clamp(2.25rem, 5vw, 3.25rem);
		margin-bottom: 0.75rem;
	}
	.page-hero p {
		color: var(--theme-on-bg-muted);
		max-width: 620px;
		margin: 0 auto;
	}

	.resource-tabs {
		display: flex;
		justify-content: center;
		gap: 0.75rem;
		margin: 0 auto 3rem;
		flex-wrap: wrap;
	}
	.resource-tab {
		background-color: var(--theme-surface-1);
		border: 1px solid var(--theme-border);
		color: var(--theme-on-bg-muted);
		padding: 0.7rem 1.5rem;
		border-radius: var(--theme-button-border-radius);
		font-weight: 700;
		font-size: var(--font-size-sm);
		cursor: pointer;
		transition: background-color var(--theme-transition), color var(--theme-transition), border-color var(--theme-transition), transform var(--theme-transition);
	}
	.resource-tab:hover {
		border-color: var(--theme-primary);
		color: var(--theme-on-bg);
	}
	.resource-tab.is-active {
		background-color: var(--theme-accent);
		border-color: var(--theme-accent);
		color: var(--theme-on-primary);
		transform: translateY(-1px);
	}

	.resource-panel {
		margin: 0 auto 4rem;
	}

	.code-group {
		margin-bottom: 3rem;
	}
	.code-group:last-child {
		margin-bottom: 0;
	}
	.code-group__label {
		font-size: 1.1rem;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--theme-primary);
		margin: 0 0 1.25rem 0;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid var(--theme-border);
	}

	.posts-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2rem;
	}
	@media (min-width: 768px) {
		.posts-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	.post-card {
		display: flex;
		flex-direction: column;
		background: linear-gradient(160deg, var(--theme-surface-1), var(--theme-bg-elevated));
		border: 1px solid var(--theme-border);
		border-radius: var(--theme-shape-radius);
		overflow: hidden;
		text-decoration: none;
		color: var(--theme-on-bg);
		transition: transform var(--theme-transition), border-color var(--theme-transition), box-shadow var(--theme-transition);
	}
	.post-card:hover {
		transform: translateY(-4px);
		border-color: rgba(127, 216, 255, 0.35);
		box-shadow: 0 16px 32px -18px rgba(0, 0, 0, 0.6);
	}
	.post-card__image-wrap {
		width: 100%;
		aspect-ratio: 1.42 / 1;
		overflow: hidden;
		border-bottom: 1px solid var(--theme-border);
	}
	.post-card__image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.post-card__content {
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		flex-grow: 1;
	}
	.post-card__content h3 {
		margin: 0 0 0.75rem 0;
		font-size: 1.4rem;
		color: var(--theme-on-bg);
	}
	.post-card__content p {
		margin: 0;
		color: var(--theme-on-bg-muted);
		font-size: 0.95rem;
		line-height: 1.6;
	}

	.notes-intro {
		text-align: center;
		max-width: 720px;
		margin: 0 auto 2.5rem;
		font-style: italic;
		color: var(--theme-on-bg-muted);
		line-height: 1.7;
	}
	.notes-list {
		max-width: 800px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}
	.category-card {
		display: block;
		background: linear-gradient(160deg, var(--theme-surface-1), var(--theme-bg-elevated));
		border: 1px solid var(--theme-border);
		border-left: 4px solid var(--theme-accent);
		padding: 1.5rem 2rem;
		border-radius: 0 var(--theme-shape-radius) var(--theme-shape-radius) 0;
		text-decoration: none;
		color: var(--theme-on-bg);
		transition: transform var(--theme-transition), border-color var(--theme-transition), box-shadow var(--theme-transition);
	}
	.category-card:hover {
		transform: translateY(-3px);
		border-color: var(--theme-primary);
		box-shadow: 0 16px 32px -18px rgba(0, 0, 0, 0.6);
	}
	.category-card h2 {
		margin-top: 0;
		font-size: 1.5rem;
		color: var(--theme-primary);
	}
	.category-card p {
		margin: 0;
		color: var(--theme-on-bg-muted);
		line-height: 1.7;
	}

	.feynman-quote {
		position: relative;
		margin: 5rem auto;
		padding: 3rem 1.5rem;
		max-width: 720px;
		text-align: center;
	}
	.feynman-quote__mark {
		display: block;
		font-family: var(--theme-font-family-serif);
		font-size: 5rem;
		line-height: 1;
		color: var(--theme-highlight);
		opacity: 0.5;
		margin-bottom: -1rem;
	}
	.feynman-quote p:not(.author) {
		font-style: italic;
		font-size: 1.3rem;
		line-height: 1.6;
		color: var(--theme-on-bg);
		font-family: var(--theme-font-family-serif);
	}
	.feynman-quote .author {
		font-style: normal;
		font-weight: 700;
		margin-top: 1.25rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		font-size: var(--font-size-sm);
		color: var(--theme-primary);
	}
</style>
