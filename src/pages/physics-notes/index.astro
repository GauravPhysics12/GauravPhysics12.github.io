---
import { Container } from '@components/odyssey-theme';
import Layout from '../../layouts/Page.astro';
import { categories } from '../../config/notes.js';
---

<Layout>
	<section class="hero">
		<Container>
			<h1>Physics Notes</h1>
			<p>A collection of my study and research notes, organized by topic.</p>
		</Container>
	</section>

	<Container>
		<section class="notes-intro">
			<p>
				These notes are a synthesis of core texts like Sean Carroll's <em>Spacetime and Geometry</em>, Bernard Schutz's <em>A First Course in General Relativity</em>, and Prof. Frederic Schuller's lectures.
			</p>
			<strong>I have also integrated presentation slides from my various guest lectures and workshops.</strong>
		</section>
	</Container>

	<Container>
		<section class="notes-list">
			{categories.map((category) => {
				if (!category || !category.name) return null;

				return (
					<a href={`/physics-notes/${category.slug}`} class="category-card">
						<h2>{category.name}</h2>
						<p>{category.description}</p>
					</a>
				);
			})}
		</section>
	</Container>

	<div class="feynman-quote">
		<span class="feynman-quote__mark" aria-hidden="true">&ldquo;</span>
		<p>Study hard what interests you the most in the most undisciplined, irreverent and original manner possible.</p>
		<p class="author">— Richard Feynman</p>
	</div>
</Layout>

<style>
	.hero {
		text-align: center;
		padding: 5rem 1rem 3rem;
	}
	.hero h1 {
		font-size: clamp(2.25rem, 5vw, 3.25rem);
		margin-bottom: 0.75rem;
	}
	.hero p {
		color: var(--theme-on-bg-muted);
		max-width: 620px;
		margin: 0 auto;
	}

	.notes-intro {
		text-align: center;
		max-width: 720px;
		margin: 0 auto 1rem;
		font-style: italic;
		color: var(--theme-on-bg-muted);
		line-height: 1.7;
	}
	.notes-intro strong {
		display: block;
		margin-top: 1rem;
		color: var(--theme-on-bg);
		font-style: normal;
	}

	.notes-list {
		margin: 3rem auto;
		max-width: 800px;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}
	.category-card {
		display: block;
		background: linear-gradient(160deg, var(--theme-surface-1), var(--theme-bg-elevated));
		border: 1px solid var(--theme-border);
		border-left: 4px solid var(--theme-accent);
		padding: 1.5rem 2rem;
		border-radius: 0 var(--theme-shape-radius) var(--theme-shape-radius) 0;
		text-decoration: none;
		color: var(--theme-on-bg);
		transition: transform var(--theme-transition), border-color var(--theme-transition), box-shadow var(--theme-transition);
	}
	.category-card:hover {
		transform: translateY(-3px);
		border-color: var(--theme-primary);
		box-shadow: 0 16px 32px -18px rgba(0, 0, 0, 0.6);
	}
	.category-card h2 {
		margin-top: 0;
		font-size: 1.5rem;
		color: var(--theme-primary);
	}
	.category-card p {
		margin: 0;
		color: var(--theme-on-bg-muted);
		line-height: 1.7;
	}

	.feynman-quote {
		position: relative;
		margin: 5rem auto;
		padding: 3rem 1.5rem;
		max-width: 720px;
		text-align: center;
	}
	.feynman-quote__mark {
		display: block;
		font-family: var(--theme-font-family-serif);
		font-size: 5rem;
		line-height: 1;
		color: var(--theme-highlight);
		opacity: 0.5;
		margin-bottom: -1rem;
	}
	.feynman-quote p:not(.author) {
		font-style: italic;
		font-size: 1.3rem;
		line-height: 1.6;
		color: var(--theme-on-bg);
		font-family: var(--theme-font-family-serif);
	}
	.feynman-quote .author {
		font-style: normal;
		font-weight: 700;
		margin-top: 1.25rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		font-size: var(--font-size-sm);
		color: var(--theme-primary);
	}
</style>
