---
import { Container } from '@components/odyssey-theme';
import Layout from '../../layouts/Page.astro';
import { getCollection } from 'astro:content';

const codePosts = await getCollection('codes');

const sortedPosts = codePosts.sort(
	(a, b) => new Date(b.data.publishDate).valueOf() - new Date(a.data.publishDate).valueOf()
);
---

<Layout>
	<Container>
		<div class="page-hero">
			<h1>Coding &amp; Software</h1>
			<p>From numerical simulations to introductory scripts for beginners.</p>
		</div>

		<section class="posts-list-section">
			<div class="posts-grid">
				{sortedPosts.map((post) => (
					<a href={`/codes/${post.slug}`} class="post-card">
						{post.data.featuredImage && (
							<div class="post-card__image-wrap">
								<img src={post.data.featuredImage} alt={post.data.title} class="post-card__image" />
							</div>
						)}
						<div class="post-card__content">
							<h3>{post.data.title}</h3>
							<p>{post.data.excerpt}</p>
						</div>
					</a>
				))}
			</div>
		</section>
	</Container>

	<div class="feynman-quote">
		<span class="feynman-quote__mark" aria-hidden="true">&ldquo;</span>
		<p>It doesn't matter how beautiful your theory is, it doesn't matter how smart you are. If it doesn't agree with experiment, it's wrong.</p>
		<p class="author">— Richard Feynman</p>
	</div>
</Layout>

<style>
	.page-hero {
		text-align: center;
		padding: 5rem 1rem 3rem;
	}
	.page-hero h1 {
		font-size: clamp(2.25rem, 5vw, 3.25rem);
		margin-bottom: 0.75rem;
	}
	.page-hero p {
		color: var(--theme-on-bg-muted);
		max-width: 620px;
		margin: 0 auto;
	}

	.posts-list-section {
		margin: 1rem auto 4rem;
	}
	.posts-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2rem;
	}
	@media (min-width: 768px) {
		.posts-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	.post-card {
		display: flex;
		flex-direction: column;
		background: linear-gradient(160deg, var(--theme-surface-1), var(--theme-bg-elevated));
		border: 1px solid var(--theme-border);
		border-radius: var(--theme-shape-radius);
		overflow: hidden;
		text-decoration: none;
		color: var(--theme-on-bg);
		transition: transform var(--theme-transition), border-color var(--theme-transition), box-shadow var(--theme-transition);
	}
	.post-card:hover {
		transform: translateY(-4px);
		border-color: rgba(127, 216, 255, 0.35);
		box-shadow: 0 16px 32px -18px rgba(0, 0, 0, 0.6);
	}

	.post-card__image-wrap {
		width: 100%;
		background-color: var(--theme-bg);
		border-bottom: 1px solid var(--theme-border);
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.post-card__image {
		width: 100%;
		height: auto;
		max-height: 320px;
		object-fit: contain;
		display: block;
	}

	.post-card__content {
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		flex-grow: 1;
	}
	.post-card__content h3 {
		margin: 0 0 0.75rem 0;
		font-size: 1.4rem;
		color: var(--theme-on-bg);
	}
	.post-card__content p {
		margin: 0;
		color: var(--theme-on-bg-muted);
		font-size: 0.95rem;
		line-height: 1.6;
	}

	.feynman-quote {
		position: relative;
		margin: 5rem auto;
		padding: 3rem 1.5rem;
		max-width: 720px;
		text-align: center;
	}
	.feynman-quote__mark {
		display: block;
		font-family: var(--theme-font-family-serif);
		font-size: 5rem;
		line-height: 1;
		color: var(--theme-highlight);
		opacity: 0.5;
		margin-bottom: -1rem;
	}
	.feynman-quote p:not(.author) {
		font-style: italic;
		font-size: 1.3rem;
		line-height: 1.6;
		color: var(--theme-on-bg);
		font-family: var(--theme-font-family-serif);
	}
	.feynman-quote .author {
		font-style: normal;
		font-weight: 700;
		margin-top: 1.25rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		font-size: var(--font-size-sm);
		color: var(--theme-primary);
	}
</style>
