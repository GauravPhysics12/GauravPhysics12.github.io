---
import { Icon } from 'astro-icon/components';
import Logo from '../Logo.astro';
const { navData } = Astro.props;
---

<script type="module">
  const bodyElement = document.querySelector('body');
  const menuButton = document.querySelector('#menuButton');
  const navHeader = document.querySelector('#odysseyNavHeader');
  const menuButtonIconHam = document.querySelector('#menuButtonIconHam');
  const menuButtonIconClose = document.querySelector('#menuButtonIconClose');
  let scrollPosition = 0;

  menuButton.addEventListener('click', toggleMenu);

  function toggleMenu() {
    menuButtonIconHam.toggleAttribute('hidden');
    menuButtonIconClose.toggleAttribute('hidden');
    
    if (navHeader.hasAttribute('mobile-menu-open')) {
      menuButton.title = "Open Main Menu";
      bodyElement.style.removeProperty('overflow');
      bodyElement.style.removeProperty('position');
      bodyElement.style.removeProperty('top');
      bodyElement.style.removeProperty('width');
      window.scrollTo(0, scrollPosition);
    } else {
      menuButton.title = "Close Main Menu";
      scrollPosition = window.pageYOffset;
      bodyElement.style.overflow = 'hidden';
      bodyElement.style.position = 'fixed';
      bodyElement.style.top = `-${scrollPosition}px`;
      bodyElement.style.width = '100%';
    }
    
    navHeader.toggleAttribute('mobile-menu-open');
  }

  // ---- Day / night theme toggle ----
  const themeToggle = document.querySelector('#themeToggle');
  const docEl = document.documentElement;

  themeToggle.addEventListener('click', () => {
    const isLight = docEl.getAttribute('data-theme') === 'light';
    const nextTheme = isLight ? 'dark' : 'light';
    docEl.setAttribute('data-theme', nextTheme);
    localStorage.setItem('theme', nextTheme);
  });
</script>

<header id="odysseyNavHeader">
  <div class="header-logo-menu__container">
    <Logo />
    <button id="menuButton" title="Open Main Menu">
      <span id="menuButtonIconHam">
        <Icon name="ic:baseline-menu" width="30px" height="30px" />
      </span>
      <span id="menuButtonIconClose" hidden>
        <Icon name="ic:baseline-close" width="30px" height="30px" />
      </span>
    </button>
    </div>
  <div class="header-nav__container">
    <nav>
      <ul>
        {navData && navData.map(navItem => (
          <li><a href={navItem.slug}>{navItem.title}</a></li>
        ))}
      </ul>
    </nav>
  </div>
  <button id="themeToggle" class="theme-toggle" title="Toggle day / night">
    <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="12" cy="12" r="5" fill="currentColor"/>
      <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M12 2v2"/><path d="M12 20v2"/><path d="M4.93 4.93l1.41 1.41"/>
        <path d="M17.66 17.66l1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/>
        <path d="M4.93 19.07l1.41-1.41"/><path d="M17.66 6.34l1.41-1.41"/>
      </g>
    </svg>
    <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" fill="currentColor"/>
    </svg>
  </button>
</header>

<style>
  header {
    width: 100%;
    padding: 1rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 200;
    background-color: var(--theme-header-glass);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--theme-border);
  }
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 1px solid var(--theme-border);
    background-color: var(--theme-surface-1);
    color: var(--theme-on-bg);
    cursor: pointer;
    transition: border-color var(--theme-transition), transform var(--theme-transition);
  }
  .theme-toggle:hover {
    border-color: var(--theme-primary);
    transform: scale(1.05);
  }
  .theme-toggle .icon-moon {
    color: var(--theme-primary);
  }
  .theme-toggle .icon-sun {
    color: var(--theme-highlight);
  }
  /* Default (no attribute, or explicit dark) = night: show the moon icon
     as the *current state*, sun icon hidden until you're in daytime. */
  .theme-toggle .icon-sun { display: none; }
  .theme-toggle .icon-moon { display: block; }
  :global(html[data-theme='light']) .theme-toggle .icon-sun { display: block; }
  :global(html[data-theme='light']) .theme-toggle .icon-moon { display: none; }
  .header-logo-menu__container {
    display: flex;
    align-items: center;
    gap: 1rem;
    z-index: 100;
  }
  #menuButton {
    outline: none;
    border: none;
    background-color: transparent;
    display: none; /* Hidden on desktop */
    cursor: pointer;
    color: inherit;
  }
  nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    gap: 2rem;
  }
  nav ul li a {
    text-decoration: none;
    color: var(--theme-on-bg);
    opacity: 0.75;
    font-size: var(--font-size-sm);
    font-weight: 500;
    transition: opacity 0.2s ease, color 0.2s ease;
  }
  nav ul li a:hover {
    opacity: 1;
    color: var(--theme-primary);
  }
  
  /* Mobile Styles */
  @media(max-width: 768px) {
    #menuButton {
      display: block;  
    }
    .header-nav__container {
      width: 100%;
      height: 100%;
      background-color: var(--theme-bg-elevated);
      display: none;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      position: fixed;
      inset: 0;
      z-index: 99;
    }
    header[mobile-menu-open] .header-nav__container {
      display: flex;
    }
    header[mobile-menu-open] nav ul {
      align-items: center;
      flex-direction: column;
      gap: 2.5rem;
    }
    header[mobile-menu-open] nav ul li {
      font-size: 1.5rem;
    }
  }
</style>